# P2b 片三 SUM-002（暂定，待 oracle）fixture：顶层自定义汇总 + 隐式 values 作用域。
# customAverage 为官方示例形态 values.mean().round(3)；customBad 越权引用 file.name
# （无行上下文 → MISSING → 结果 null，暂定口径可观察）。
summaries:
  customAverage: 'values.mean().round(3)'
  customBad: 'file.name'
views:
  - type: table
    name: custom
    summaries:
      score: customAverage
  - type: table
    name: customBadScope
    summaries:
      score: customBad
  # groupBy 与 summaries 同现：summaries 仍按全量集计算一份（组级汇总无头 JSON 暂不做）
  - type: table
    name: withGroup
    order:
      - file.name
      - status
      - score
    groupBy:
      property: status
      direction: ASC
    summaries:
      score: Average
