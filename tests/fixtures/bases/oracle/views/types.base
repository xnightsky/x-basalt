# oracle 争议语义⑤⑥：date vs datetime 比较（BASE-TYPE-005）与 frontmatter wikilink → Link（BASE-TYPE-006）
# 样本：CaseE（due="2026-07-27"、created="2026-07-01T10:30:00"、related="[[CaseB]]"）。
# 观察：date 与 datetime 跨精度 == /< 的官方口径；wikilink 字符串是否成 Link 值、
# `related == "[[CaseB]]"` 与裸字符串比较是否命中、投影呈现形态。
views:
  - type: table
    name: date-eq-literal
    filters: due == "2026-07-27"
    order:
      - file.name
      - due
  - type: table
    name: date-lt-datetime
    filters: due < created
    order:
      - file.name
  - type: table
    name: datetime-lt-date
    filters: created < due
    order:
      - file.name
  - type: table
    name: link-eq-wikilink
    filters: related == "[[CaseB]]"
    order:
      - file.name
      - related
  - type: table
    name: link-projection
    order:
      - file.name
      - related
  # oracle 争议语义⑨：字符串→日期推断是否作用于 `+`（拼接语境）。
  # x-basalt 暂定：推断对全部非短路二元运算生效，故 due 升为 Date、`date + string` 报类型错误。
  # concat-plain-string 是对照组——先确认官方 string+string 拼接本身可用，
  # 否则 concat-date-string 的错误无法区分「不支持拼接」与「拼接语境仍做日期推断」。
  - type: table
    name: concat-plain-string
    order:
      - file.name
      - 'label + " 备注"'
  - type: table
    name: concat-date-string
    order:
      - file.name
      - 'due + " 备注"'

# ============================================================================
# 2026-07-29 补：⑩..⑳㉖ 的 fixture view（runbook §1.1/§1.2 的 fixture 缺口）
#
# 这批口径的判据**全在投影列的值里**，不在行集里——所以不必一条一个 view，
# 一个 view 挂一批常量表达式列，一次渲染就能读回全部答案（取证脚本已采 cells）。
# 每个 view 都用 `file.path` 过滤到单行：`file.name` 官方渲染不带扩展名、
# x-basalt 带（runbook §4 注），拿它做 filter 会两边行集不同。
#
# ⚠️ 隔离原则：**已知会报错或可能是本仓自建扩展的表达式单独占一个 view**。
# 官方遇到不认识的函数可能整个 view 求值失败，混在一起会把同伴的读数一起废掉。
# （x-basalt 侧实测是列级隔离——同 view 里一列报错不影响其他列；官方是否如此未知，
# 所以按最坏情况隔离。）
# ============================================================================

  # ⑩ title / ⑪ slice（负索引与越界钳制）/ ⑫ replace / ⑬ reverse。全是低风险常量表达式。
  # x-basalt 当前读数：Hello World Foo · def · bc · abc · a-b-c · olléh · [3,4]
  # ⑫ 判别力：若 replace 是 regex，`.` 会匹配任意字符 → "-----"；字面替换才得 "a-b-c"。
  # ⑬ 判别力：olléh 说明按 code point 反转且未拆坏组合字符。
  - type: table
    name: str-list-methods
    filters: file.path == "notes/CaseA.md"
    order:
      - '"hello world foo".title()'
      - '"abcdef".slice(-3)'
      - '"abcdef".slice(1, 3)'
      - '"abc".slice(0, 99)'
      - '"a.b.c".replace(".", "-")'
      - '"héllo".reverse()'
      - 'list(1, 2, 3, 4).slice(-2)'

  # ⑧(a) 的**硬前置**——单独占一个 view，绝不与别的表达式混：这是七条里唯一
  # 「两个结果都能把决策钉死」的取证点，被同伴的求值失败连坐损失最大。
  #
  # x-basalt 当前（oracle ⑧(a) 定案 2026-08-02 后）：list(1,2,null).mean() → 1
  #                （非 number 不计分子、计分母）· list(1,2).mean() → 1.5
  # 定案依据：官方 filter 里 list() 非字面量（直测关闭），汇总通道 values.mean()=0.25
  # （entries=12）证实 values 含空值且计分母 → 改 list.mean() + values 作用域（breaking）。
  - type: table
    name: mean-mixed-list
    filters: file.path == "notes/CaseA.md"
    order:
      - 'list(1, 2, null).mean()'
      - 'list(1, 2).mean()'

  # ⑮ date.time() 返回什么（oracle ⑮ 定案：官方 "HH:mm:ss" 字符串，本仓已跟）
  # ⑯ date.format() 的数字 token / ⑰ date.relative() 的措辞与阶梯
  # x-basalt 当前（CaseE.created = 2026-07-01T10:30:00）：
  #   time() → "10:30:00" · format("YYYY-MM-DD") → "2026-07-01"
  #   format("HH:mm:ss") → "10:30:00" · relative() → "1 month ago"
  # ⚠️ relative() 依赖当前时间，跨日重跑数值会变——判读看**措辞与阶梯**（英文？月=31d？），
  # 不把具体字符串当稳定结论。
  - type: table
    name: date-methods
    filters: file.path == "notes/CaseE.md"
    order:
      - 'created.time()'
      - 'created.format("YYYY-MM-DD")'
      - 'created.format("HH:mm:ss")'
      - 'created.relative()'

  # ⑯ 的另一半：本地化 token。**已知在 x-basalt 侧报错**故隔离——本仓有意只做数字 token
  # （月名/星期名随界面语言变，非稳定输出）。看官方认不认 MMMM，认的话输出什么语言。
  - type: table
    name: date-format-localized
    filters: file.path == "notes/CaseE.md"
    order:
      - 'created.format("MMMM")'

  # ⑱ date(number) / duration(number) —— 源码自认「自建扩展」，官方很可能**根本没有**
  # 这两个重载。隔离的理由就在这：它是本批最可能整个 view 炸掉的一个。
  # x-basalt 当前：date(0) → 1970-01-01T00:00:00Z（epoch 毫秒）· duration(1000) → 1000（毫秒）
  # 官方报错或给空 → 结论是「本仓超集」，落 boundary，不改实现。
  - type: table
    name: ext-constructors
    filters: file.path == "notes/CaseA.md"
    order:
      - 'date(0)'
      - 'duration(1000)'

  # ㉖ duration 的 month/year 固定换算（本仓：month=30d、year=365d，作用于**全部** duration
  # 算术而不只是 relative()）。x-basalt 当前（oracle ㉖ 后）：2678400000（31d）· 31536000000（365d）
  - type: table
    name: duration-units
    filters: file.path == "notes/CaseA.md"
    order:
      - 'duration("1 month")'
      - 'duration("1 year")'

  # ⑭ number/date 的 isEmpty() 恒 false（本仓口径）。用常量而非行属性：
  # 混用行属性会让 CaseA 行的 created 为 MISSING，读数掺进「空值怎么办」的第二个变量。
  - type: table
    name: is-empty-nonstring
    filters: file.path == "notes/CaseA.md"
    order:
      - 'number(0).isEmpty()'
      - 'date("2026-07-01").isEmpty()'

  # ⑲ file(path) 的解析范围（本仓：只在**当前查询行集**内解析，不查库不碰文件系统）
  # ⑳ linksTo 的两种入参语义（本仓：file 值走解析比 path，string/link 走文本匹配）
  # 样本依赖 CaseE 正文里的 [[CaseB]]（2026-07-29 加，见该文件注释）。
  # x-basalt 当前：notes/CaseB.md · null(解析不到) · true · true · true
  # ⑲ 判别力：`file("不存在的笔记")` 给 null 而非报错，说明解析不到 → MISSING 而非伪造空值。
  - type: table
    name: file-fn-resolve
    filters: file.path == "notes/CaseE.md"
    order:
      - 'file("CaseB").path'
      - 'file("不存在的笔记").path'
      - 'file.linksTo(file("CaseB"))'
      - 'file.linksTo("CaseB")'
      - 'file.hasLink("CaseB")'

# ============================================================================
# 2026-08-02 补：⑧(a)/⑩..⑳㉖ 的 **filter 上下文**取证（round-2 教训）
#
# round-2 实测（Obsidian 1.13.4）：官方把 `note.<expr>` / 裸表达式**列**当属性列处理——
# 不求值、无错误、渲染为空（cachedFormulaOutputs={}、propertyEditor 空）。因此上面
# 07-29 那批「表达式列」view 判不出函数值，必须把表达式放进**官方会求值的上下文**。
# round-1 已证明 filter 会求值（date-eq-literal 等），故这批全部用 filter 谓词：
#   谓词为真 → 12 行；谓词为假 → 0 行；官方不认该函数 → errors 非空（照录不判读）。
# 每个谓词**独立占一个 view**（隔离原则：官方对不认识的函数可能整个 view 求值失败）。
# 无 filter 的基线仍 12 行（fixture 文件数未变）。
# ============================================================================

  # ⑧(a) 决定性二分：官方 `list(1, 2, null).mean()` 到底等于什么。
  #   == 1   → M1 成立：null 计入分母（(1+2)/3）→ 改 list.mean() + values 作用域
  #   == 1.5 → M2 成立：null 只被剔除（(1+2)/2）→ 维持现状
  #   两 view 都 0 行且 errors 非空 → 官方根本不支持混合列表 mean → ⑧(a) 翻 boundary
  - type: table
    name: mean-mixed-eq-1
    filters: 'list(1, 2, null).mean() == 1'
    order:
      - file.path
  - type: table
    name: mean-mixed-eq-15
    filters: 'list(1, 2, null).mean() == 1.5'
    order:
      - file.path

  # ⑩ title()：按空白切词 + 词首大写 + 词余小写。
  - type: table
    name: str-title-eq
    filters: '"hello world foo".title() == "Hello World Foo"'
    order:
      - file.path

  # ⑪ slice(start, end?)：负索引从尾数；end 排他；越界钳制。
  - type: table
    name: str-slice-neg-eq
    filters: '"abcdef".slice(-3) == "def"'
    order:
      - file.path
  - type: table
    name: str-slice-end-eq
    filters: '"abcdef".slice(1, 3) == "bc"'
    order:
      - file.path
  - type: table
    name: str-slice-clamp-eq
    filters: '"abc".slice(0, 99) == "abc"'
    order:
      - file.path

  # ⑫ replace(a, b)：字面子串全局替换 vs 只替首个 vs regex（`.` 匹配任意字符）。
  #   global → "a-b-c"；first-only → "a-b.c"；regex(首匹配) → "-.b.c"。
  - type: table
    name: str-replace-global-eq
    filters: '"a.b.c".replace(".", "-") == "a-b-c"'
    order:
      - file.path
  - type: table
    name: str-replace-first-eq
    filters: '"a.b.c".replace(".", "-") == "a-b.c"'
    order:
      - file.path

  # ⑬ reverse()：用 BMP 外的代理对（💩 U+1F4A9）区分 code point 与 code unit 反转。
  #   code point → "b💩a"；code unit（代理对拆坏）→ 不会是 "b💩a"。
  - type: table
    name: str-reverse-astral-eq
    filters: '"a💩b".reverse() == "b💩a"'
    order:
      - file.path

  # ⑭ number/date 的 isEmpty() 恒 false（各自独立成 view，避免一个报错连坐另一个）。
  - type: table
    name: is-empty-num-eq
    filters: 'number(0).isEmpty() == false'
    order:
      - file.path
  - type: table
    name: is-empty-date-eq
    filters: 'date("2026-07-01").isEmpty() == false'
    order:
      - file.path

  # ⑮ date.time() 的返回值形态：官方 = "HH:mm:ss" 字符串（round-2 实据），本仓已跟；
  #   两个候选（毫秒数 / duration 对象）官方都 0 行——这两个 view 现在两侧都 0 行，作对照留档。
  - type: table
    name: date-time-ms-eq
    filters: 'date("2026-07-01T10:30:00").time() == 37800000'
    order:
      - file.path
  - type: table
    name: date-time-dur-eq
    filters: 'date("2026-07-01T10:30:00").time() == duration(37800000)'
    order:
      - file.path

  # ⑯ date.format() 的数字 token（YYYY-MM-DD / HH:mm:ss）。
  - type: table
    name: date-format-ymd-eq
    filters: 'date("2026-07-01").format("YYYY-MM-DD") == "2026-07-01"'
    order:
      - file.path
  - type: table
    name: date-format-hms-eq
    filters: 'date("2026-07-01T10:30:00").format("HH:mm:ss") == "10:30:00"'
    order:
      - file.path

  # ⑯ 另一半：本地化 token（x-basalt 有意拒绝，隔离；看官方认不认、输出什么语言）。
  - type: table
    name: date-format-localized-eq
    filters: 'date("2026-07-01").format("MMMM") == "July"'
    order:
      - file.path

  # ⑱ date(number) / duration(number)（x-basalt 自建扩展，官方很可能没有）。
  #   date(1000)：epoch 毫秒 → 1970-01-01T00:00:01；epoch 秒 → 00:16:40。
  - type: table
    name: ext-date-ms-eq
    filters: 'date(1000) == date("1970-01-01T00:00:01")'
    order:
      - file.path
  - type: table
    name: ext-duration-num-eq
    filters: 'duration(1000) == 1000'
    order:
      - file.path

  # ⑲ file(path) 的解析结果路径形态（本仓 "notes/CaseB.md"；官方若只给文件名则 0 行）。
  - type: table
    name: file-resolve-eq
    filters: 'file("CaseB").path == "notes/CaseB.md"'
    order:
      - file.path

  # ⑳ linksTo 两种入参：file 值走解析比 path；string/link 走文本匹配。
  # 样本依赖 CaseE 正文里的 [[CaseB]]——两个谓词各自独立成 view。
  - type: table
    name: file-links-to-resolve-eq
    filters: 'file.linksTo(file("CaseB")) == true'
    order:
      - file.path
  - type: table
    name: file-links-to-text-eq
    filters: 'file.linksTo("CaseB") == true'
    order:
      - file.path

  # ㉖ duration 的 month/year 固定换算（本仓 30d / 365d）。
  - type: table
    name: duration-month-eq
    filters: 'duration("1 month") == duration("30 days")'
    order:
      - file.path
  - type: table
    name: duration-year-eq
    filters: 'duration("1 year") == duration("365 days")'
    order:
      - file.path

# ============================================================================
# 2026-08-02 第二批：第一轮 0 行的 view 全是「无 errors 静默失败」，无法区分
# 「求值为假」与「函数不认」。这批补**机制对照组**：先证明该函数+== 通道在官方
# 可用，再判第一轮的 0 行是真假值还是函数缺失。全部沿用隔离原则。
# ============================================================================

  # ⑧(a) 机制对照：纯列表 mean 通道是否可用（可用 → mean-mixed 的 0/0 是官方
  # 真值 ≠1/≠1.5；不可用 → mean-mixed 两 view 作废，⑧(a) 仍需另想办法）。
  - type: table
    name: mean-pure-eq-15
    filters: 'list(1, 2).mean() == 1.5'
    order:
      - file.path

  # ⑬ 机制对照：BMP 字符串 reverse 是否可用（可用 → astral 0 行说明官方对代理对
  # 的处理与本仓不同；不可用 → reverse 整体缺失，astral 0 行无判别力）。
  - type: table
    name: str-reverse-bmp-eq
    filters: '"abc".reverse() == "cba"'
    order:
      - file.path

  # ⑮ 候选形态：time() 若返回 "HH:mm" / "HH:mm:ss" 字符串，二者其一应命中。
  - type: table
    name: date-time-hhmm-str-eq
    filters: 'date("2026-07-01T10:30:00").time() == "10:30"'
    order:
      - file.path
  - type: table
    name: date-time-hhmmss-str-eq
    filters: 'date("2026-07-01T10:30:00").time() == "10:30:00"'
    order:
      - file.path

  # ㉖ month 长度钉死：year=365d 已证实 duration(string)+== 通道可用，
  # month ≠ 30d 是真实差异；试 31d / 28d。
  - type: table
    name: duration-month-31-eq
    filters: 'duration("1 month") == duration("31 days")'
    order:
      - file.path
  - type: table
    name: duration-month-28-eq
    filters: 'duration("1 month") == duration("28 days")'
    order:
      - file.path

  # ⑱ 机制对照：date(字面量)+== 通道可用与否（决定 ext-date-ms 的 0 行怎么读）。
  - type: table
    name: date-self-eq
    filters: 'date("2026-07-01") == date("2026-07-01")'
    order:
      - file.path
  # date(number) 若是 epoch **秒**：1000s = 1970-01-01T00:16:40。
  - type: table
    name: ext-date-sec-eq
    filters: 'date(1000) == date("1970-01-01T00:16:40")'
    order:
      - file.path

  # ⑯ 本地化 token：MMMM 若不是英文 July，试中文（界面语言候选）。
  - type: table
    name: date-format-localized-zh-eq
    filters: 'date("2026-07-01").format("MMMM") == "七月"'
    order:
      - file.path

  # ⑧(a) 字符串输出候选：mean 若返回字符串形态（官方函数值渲染为文本），
  # 与 number 比恒假；试字符串 "1"。
  - type: table
    name: mean-mixed-str1-eq
    filters: 'list(1, 2, null).mean() == "1"'
    order:
      - file.path

  # ⑧(a)/⑪ 的收尾判别：官方 filter 里的 `list(1, 2)` 到底是不是**字面量**。
  # 若 isEmpty()==false 命中 12 行 → list() 是字面量，mean() 的 0/0 是值形态问题；
  # 若 0 行 → list() 不是字面量（更像行上下文属性访问器），mean/切片字面量取证
  # 路径整体关闭，⑧(a) 只能由汇总读数（values.mean()=0.25、entries=12）定论。
  - type: table
    name: list-literal-is-empty-eq
    filters: 'list(1, 2).isEmpty() == false'
    order:
      - file.path
