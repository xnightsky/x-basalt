{
  // chat（自然语言路径）的独立说明书，从 core 分离而来。
  //
  // 为什么分离：chat 讲的是**另一条路径**——工具形态（cli 单执行口 + skills 元工具）、JSON 参数、
  // AI_GATEWAY 配置、REPL——这些在「CLI 直调」场景一个字都用不上，混在 core 里是纯负担。
  // 分离依据不是体量（chat 仅占 core 约 9%），而是语义纯度：一篇说明书不该同时讲两条路径。
  //
  // 与 core / pipe 的分工：本篇只写「chat 特有」的部分——工具形态与参数、chat 侧的三态、配 key。
  // 每个子命令背后的语义一律去对应正文取（读写命令 → core，run 批量 → pipe），不在此重抄。
  //
  // triggers 只吃 AI 词（chat/ai/自然语言/key/model/离线…），与 core 的说明书词、pipe 的管道词、
  // summary 的总览词刻意不重叠——于是 `recall 配 key` 只召回本篇而非 core 全文。
  name: "chat",
  description: "x-basalt chat 自然语言路径：调用形态（单发/REPL/--quiet/--json）、三个内部工具（cli 单执行口 + skills 元工具）与 CLI 命令的对应关系、chat 侧没有或禁止的能力、AI_GATEWAY 配置与安全模型。CLI 直调不需要本篇。",
  triggers: [
    "chat",
    "ai",
    "AI",
    "自然语言",
    "聊天",
    "对话",
    "llm",
    "agent",
    "gateway",
    "AI_GATEWAY",
    "AI_GATEWAY_API_KEY",
    "ollama",
    "model",
    "模型",
    "离线",
    "offline",
    "api key",
    "配 key",
    "怎么配",
    "配置 ai",
    "repl",
    "quiet",
    "工具",
    "tool",
    "apikey",
    "api-key",
    "token",
    "credential",
  ],
  patterns: [
    'x-basalt chat "<自然语言>" [--quiet] [--json]  (需 AI_GATEWAY_API_KEY)',
    "x-basalt chat   # 省略参数进 REPL",
  ],
  rules: [
    {
      id: "invoke",
      pattern: 'chat ["<自然语言>"] [--model <name>] [--max-steps <n>] [--db <path>] [--vault <path>] [--quiet] [--json]',
      description: "可选 AI 子命令：用自然语言驱动既有原语，跑 plan→act→observe 循环。带参=单发翻译执行即退；省略参数=进 REPL（quit/exit/q 退出）。**被其它 AI/脚本程序化调用时加 `--quiet`（纯答案，推荐）或 `--json`（结构化），完全隐藏 plan→act→observe 过程**；因为调用方通常会把 stdout+stderr 合并进模型上下文，过程轨迹只会白占 token。人交互/REPL 才用默认完整轨迹。**免配直调**：X_BASALT_DIR 或项目配置已设 vault 时，站 repo 根直接跑即自动解析 db/vault，无需定位/读 config，也无需手传 --vault/--db（要覆盖默认才显式传）。",
      examples: [
        'x-basalt chat "把 projects 下 status 为空的笔记列出来"',
        'x-basalt chat "总结 vault 里的前端测试约定" --quiet   # 供 AI/脚本调用，只回结果',
        'x-basalt chat "给 2024 年的周报都补上 tag weekly"',
        "x-basalt chat   # 省略参数进 REPL，连续提问，quit/exit/q 退出",
      ],
    },
    {
      id: "tools",
      pattern: "chat 内部工具 ⟷ CLI 命令对应表",
      description: "chat 工具面已收编为三个工具（切 C，2026-07-30 拍板）：**cli（唯一执行口）** + skills_recall / skills_get（grounding 元工具）。cli 的入参是 `{args: string[]}`——命令与参数数组逐项原样传递（如 {args:['query','LIST FROM #x']}、{args:['base','-'],source:'…'}），不做字符串拼接。可用的子命令就是 CLI 全集减 watch/chat（parse/index/scan/query/search/base/skills/meta/run/links/lint）。query/search 返回的 `file.path` 是 vault 主键，**直接原样交给 parse/meta 即可**：chat 壳会按单根/多根布局还原物理文件，模型不要猜 repo 或 vault 目录前缀。**分页参数即 CLI 的 --offset/--size**（默认 50、上限 500，--size 0 只回 total）；计数口径与 CLI 一致（读 total，别全量再数），见 core 的「计数与分页」条。子命令语义、边界、DQL 文法一律去 core 对应命令条取。",
      examples: [
        "// CLI: x-basalt meta set note.md status done",
        '// chat 工具: cli{args:["meta","set","note.md","status","done"]}',
      ],
    },
    {
      id: "limits",
      pattern: "chat 侧没有 / 禁止的能力",
      description: "**index —— 有但慎用**：cli 子命令允许 index（全量建库），但日常增量用 scan。**base —— 可用（动态 base）**：cli base 子命令支持 - / --stdin 入参，模型可传 source 字段作为 .base 定义内容经 stdin 读取，免落盘。**watch / chat —— 禁止**：allowlist 结构性排除（watch 常驻会永不返回、挂死会话；chat 是 AI 递归入口，嵌套起 AI loop 双保险拒绝：allowlist 排除 + X_BASALT_CHAT_CHILD 环境变量检测）。**批量写走 cli run**：steps=[…] 一元素一步不切分、actions=[…] 七个经典动作简写；**changed>0 即写成功且索引已刷新**，不要再 query/scan 复核，那只是白烧步数。",
      examples: [
        "// 批量：cli{args:['run','--pipe','step=set type=note','--pipe','where=LIST FROM \"inbox\" WHERE !type']}",
        "// 动态 base：cli{args:['base','-'],source:'views:…'}",
      ],
    },
    {
      id: "config",
      pattern: "AI_GATEWAY 配置与安全模型",
      description: "最小可选 AI：**内核零 AI**、chat 隔离懒加载 SDK；没配 key = 本命令禁用，其余命令全功能照常（需 AI_GATEWAY_API_KEY，--model 覆盖模型）。**三个环境变量、Linux/macOS 与 Windows 各平台设法与持久化、离线本地端点（ollama 等）见 docs/use/ai-and-skills.md 第四节**，不在此重抄。安全：写动作直接落盘、无逐个确认弹窗——靠流式可观测 + Ctrl+C 中断在途 + 既有原子写（kill 不损坏文件）+ git 兜底。能力边界：当前做结构化任务（DQL/元数据/规范）与 FTS5 正文全文检索；语义向量检索未落地。",
      examples: [
        "export AI_GATEWAY_API_KEY=...   # Linux/macOS，持久化见 docs/use/ai-and-skills.md",
        "x-basalt chat --model anthropic/claude-opus-4.8 \"...\"",
      ],
    },
  ],
  metadata: {
    doc: "docs/use/ai-and-skills.md",
    self_recall: true,
  },
}
