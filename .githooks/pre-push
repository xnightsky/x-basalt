#!/bin/sh
# 本地门禁（不依赖云端 CI）：push 前跑质量门，任一失败即阻断 push。
# 接线方式：git config core.hooksPath .githooks（由 pnpm install 的 prepare 自动完成）。
# 谨慎绕过：git push --no-verify。
#
# 含 format:check（oxfmt）：作用域是 src tests scripts，不含 markdown/prose——
# 早年排除它的理由（「markdown 基线漂移会误阻断」）随作用域收敛已不成立。
# 行尾由 .gitattributes（* text=auto eol=lf）保证跨平台一致，此前该门禁随
# 「文件最近有没有被工具重写过」随机红绿，现已与仓库内容一致，可作硬门禁。
# 报错时跑 pnpm run format 自动修。
set -e

echo "[pre-push] typecheck…"
pnpm run typecheck

echo "[pre-push] test…"
pnpm test

echo "[pre-push] lint…"
pnpm run lint

echo "[pre-push] format…"
pnpm run format:check

echo "[pre-push] ✓ 全部通过"
